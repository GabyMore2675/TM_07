<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Laboratorio 12"
            android:textAlignment="center"
            android:textColor="#0D47A1"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="TensorFlow Lite en Android"
            android:textAlignment="center"
            android:textColor="#37474F"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:padding="16dp"
            android:text="Esta aplicación implementa dos ejemplos de TensorFlow Lite: clasificación de imágenes y clasificación de audio. Ambos procesos se ejecutan directamente en el dispositivo móvil."
            android:textColor="#263238"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Clasificar imagen" />

        <Button
            android:id="@+id/btnAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Clasificar audio" />

        <TextView
            android:id="@+id/txtResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:padding="18dp"
            android:text="Resultado de la inferencia aparecerá aquí."
            android:textColor="#111111"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>